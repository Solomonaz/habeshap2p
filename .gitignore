# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/.next-verify/
/.next-prod/
/out/
next-env.d.ts

# production
/build

# testing
/coverage

# env — NEVER commit secrets (service-role key, Tron private key, mnemonic, etc.)
# Ignore every .env* variant (.env, .env.local, .env.production, .env.mainnet …)
# but keep the committed placeholder template.
.env
.env.*
!.env.example

# stray secret / key material — a fat-finger must never commit these. Covers the
# output of scripts/gen-mainnet-keys.cjs if it's ever saved to a file, exported
# wallet keys, mnemonics, etc.
*.key
*.keys
*.secret
*keys*.txt
*secret*.txt
*mnemonic*.txt
*wallet*.txt
*private*key*.txt

# supabase local artifacts
/supabase/.temp
/supabase/.branches

# misc
.DS_Store
*.pem
*.log
npm-debug.log*

# editor
.vscode/*
!.vscode/extensions.json
.idea
