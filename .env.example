# ─────────────────────────────────────────────────────────────────────────────
# HabeshaP2P environment — copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (public — safe to expose to the browser) ───────────────────────────
# Project URL and anon key from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# ── Supabase (SECRET — server-only, bypasses Row Level Security) ─────────────────
# Service-role key. Used ONLY in server code (route handlers / server actions /
# edge functions) for escrow money-moves and admin ops. If this leaks, an attacker
# can read and rewrite every balance. Never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Used by `npm run db:types` to regenerate database.types.ts from the cloud project.
SUPABASE_PROJECT_ID="your-project-ref"

# ── Cron (Phase 3) ──────────────────────────────────────────────────────────────
# Shared secret guarding /api/cron/expire-orders. The scheduler must send it as
# `Authorization: Bearer <secret>` (Vercel Cron does this automatically) or as
# `?secret=<secret>`. If unset, the endpoint refuses to run. Generate a long
# random value, e.g. `openssl rand -hex 32`.
CRON_SECRET="a-long-random-secret"

# ── Tron / TRC-20 (Phase 7) ─────────────────────────────────────────────────────
# ALL OPTIONAL. With these unset (or blank), the app runs on the stub chain
# provider — deposit addresses are deterministic fakes and nothing broadcasts —
# which is correct for local dev and review. Leave the secrets blank until you
# wire the real provider; blank lines are treated as unset.

# Which Tron network to target: nile (default) / shasta / mainnet. Public, so
# it's a NEXT_PUBLIC_ var (drives the UI label too).
NEXT_PUBLIC_TRON_NETWORK="nile"

# Withdrawals at or above this USDT amount require manual admin approval (rule #6).
# The SQL receives this value and is authoritative; keep it in sync with the app.
WITHDRAWAL_APPROVAL_THRESHOLD="500"

# On-chain confirmations required before a deposit is credited.
TRON_MIN_CONFIRMATIONS="20"

# TronGrid API key. SECRET-ish (rate-limit token). Only read server-side.
TRON_API_KEY=""
# Hot-wallet address (public) the real provider sends from.
TRON_HOT_WALLET_ADDRESS=""
# Hot-wallet private key. SECRET. Server-side signing only (rule #6). In
# production this belongs in a secret store (Supabase secrets / Vercel encrypted
# env), NEVER a committed file, and NEVER a NEXT_PUBLIC_ var.
TRON_HOT_WALLET_PRIVATE_KEY=""
